{
  "name": "payflow-monorepo",
  "version": "1.0.0",
  "description": "PayFlow - Send Money Instantly. Never Lose a Cent. Digital Wallet & P2P Fintech Engine",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:db": "npm --prefix backend run dev:db",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend run test",
    "test": "npm run test:backend",
    "seed": "npm --prefix backend run seed",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "keywords": ["fintech", "wallet", "payments", "p2p", "mongodb-transactions", "idempotency", "concurrency"],
  "author": "Amit Shukla",
  "license": "MIT"
}

